<Window x:Class="GoVeeSmartDashboard.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:GoVeeSmartDashboard.Models"
        xmlns:views11="clr-namespace:GoVeeSmartDashboard.Views"
        xmlns:vm="using:GoVeeSmartDashboard.ViewModels"
        Title="GoVee Smart Dashboard"
        Width="680"
        Height="650">
    <TabControl Background="Wheat">
        <TabControl.Styles>
            <!--  This targets the header text of each individual tab item  -->
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="16" />
            </Style>
        </TabControl.Styles>
        <TabItem FontWeight="Bold" Header="Main">
            <Grid RowDefinitions="Auto,Auto,*">
                <DockPanel>
                    <Button Classes="primary"
                            Command="{Binding FindAndPollCommand}"
                            Content="Find / Refresh Devices"
                            DockPanel.Dock="Right" />
                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding AssemblyVersion, StringFormat='GoVee Smart Dashboard: v{0}'}" />
                        <TextBlock Margin="10,0,0,5"
                                   Foreground="#8B949E"
                                   Text="{Binding StatusMessage}" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1"
                        Padding="8"
                        Background="DarkSlateGray"
                        CornerRadius="10">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <TextBlock Margin="5,0,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="Gold"
                                   Text="System" />
                        <Ellipse Grid.Column="1"
                                 Width="10"
                                 Height="10"
                                 Margin="5,0,5,0"
                                 Fill="#39D353" />
                        <TextBlock Grid.Column="2"
                                   Foreground="Gold"
                                   Text="Automatic discovery and polling active" />
                        <TextBlock Grid.Column="3"
                                   Margin="0,0,5,0"
                                   Foreground="#8B949E"
                                   Text="{Binding LastPollTime, StringFormat='Updated: {0:HH:mm:ss}'}" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">
                                <Border Width="320"
                                        Margin="3"
                                        Background="DarkSlateGray"
                                        Classes="card">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="Gold"
                                                           Text="{Binding Name}" />
                                                <TextBlock Foreground="#8B949E" Text="{Binding Model}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="7">
                                                <Ellipse Width="11"
                                                         Height="11"
                                                         Fill="{Binding Online, Converter={x:Static views11:BoolToBrushConverter.Instance}}" />
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="Gold"
                                                           Text="{Binding OnlineText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                            <TextBlock Foreground="#8B949E" Text="{Binding Transport}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       Foreground="#6E7681"
                                                       Text="{Binding DeviceId}" />
                                        </Grid>
                                        <Border Grid.Row="2"
                                                Padding="5"
                                                Background="#0D1117"
                                                CornerRadius="12">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Ellipse Width="50"
                                                         Height="50"
                                                         Fill="{Binding StatusColor}"
                                                         Stroke="#30363D"
                                                         StrokeThickness="2" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="18,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="32"
                                                               FontWeight="Bold"
                                                               Foreground="Gold"
                                                               Text="{Binding StatusText}" />
                                                    <TextBlock FontSize="11"
                                                               Foreground="#8B949E"
                                                               Text="POWER" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="3"
                                              ColumnDefinitions="*,*,*,*"
                                              ColumnSpacing="5">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Foreground="#8B949E" Text="Temp C" />
                                                <TextBlock FontSize="18"
                                                           Foreground="Gold"
                                                           Text="{Binding TemperatureC, StringFormat='{}{0:F1}° '}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Foreground="#8B949E" Text="Temp F" />
                                                <TextBlock FontSize="18"
                                                           Foreground="Gold"
                                                           Text="{Binding TemperatureF, StringFormat='{}{0:F1}°'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Foreground="#8B949E" Text="Humidity" />
                                                <TextBlock FontSize="18"
                                                           Foreground="Gold"
                                                           Text="{Binding Humidity, StringFormat='{}{0:F1}%'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Foreground="#8B949E" Text="Battery" />
                                                <TextBlock FontSize="18"
                                                           Foreground="Gold"
                                                           Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="4"
                                                    IsVisible="{Binding IsPlug}"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                            <Button Classes="primary"
                                                    Command="{Binding TurnOnCommand}"
                                                    Content="TURN ON" />
                                            <Button Classes="danger"
                                                    Command="{Binding TurnOffCommand}"
                                                    Content="TURN OFF" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <TabItem FontWeight="Bold" Header="Settings">
            <ScrollViewer>
                <StackPanel MaxWidth="900">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="Settings" />
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="Gold"
                                       Text="GoVee REST API" />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Name="PasswordBox"
                                         PasswordChar="●"
                                         RevealPassword="{Binding #RevealToggle.IsChecked}"
                                         Text="{Binding Settings.ApiKey}" />
                                <ToggleButton Name="RevealToggle"
                                              Grid.Column="1"
                                              Content="Show"
                                              Foreground="Gold" />
                            </Grid>
                            <TextBlock FontSize="12"
                                       Foreground="#8B949E"
                                       Text="Stored locally in your Windows user profile." />
                        </StackPanel>
                    </Border>
                    <Border Background="DarkSlateGray" Classes="card">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,150" RowDefinitions="*,*,*,*">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="DemiBold"
                                           Foreground="#8B949E"
                                           Text="Polling On/Off" />
                                <CheckBox Grid.Row="0"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Content="Enabled"
                                          Foreground="Gold"
                                          IsChecked="{Binding Settings.IsPolling}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="DemiBold"
                                           Foreground="#8B949E"
                                           Text="Polling Interval (seconds)" />
                                <NumericUpDown Grid.Row="1"
                                               Grid.Column="1"
                                               Maximum="300"
                                               Minimum="2"
                                               Value="{Binding Settings.PollingIntervalSeconds}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="DemiBold"
                                           Foreground="#8B949E"
                                           Text="Plug 1 Off (Inside Temp &lt; °F)" />
                                <NumericUpDown Grid.Row="2"
                                               Grid.Column="1"
                                               Maximum="100"
                                               Minimum="32"
                                               Value="{Binding Settings.LowTempLimit, StringFormat=\{0:F2\}}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontWeight="DemiBold"
                                           Foreground="#8B949E"
                                           Text="Plug 1 On (Lanai Temp &lt; °F)" />
                                <NumericUpDown Grid.Row="3"
                                               Grid.Column="1"
                                               Maximum="100"
                                               Minimum="32"
                                               Value="{Binding Settings.HighTempLimit, StringFormat=\{0:F2\}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="DarkSlateGray" Classes="card">
                        <StackPanel Spacing="5">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="Gold"
                                       Text="Devices" />
                            <ItemsControl ItemsSource="{Binding Settings.Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ConfiguredDevice">
                                        <Border Margin="0,0,0,2"
                                                Padding="2"
                                                Background="#0D1117"
                                                CornerRadius="8">
                                            <Grid ColumnDefinitions="*,Auto,110,185,100" ColumnSpacing="5">
                                                <TextBox PlaceholderText="Name" Text="{Binding Name}" />
                                                <TextBox Grid.Column="1"
                                                         PlaceholderText="Model"
                                                         Text="{Binding Model}" />
                                                <ComboBox Grid.Column="2"
                                                          Width="110"
                                                          SelectedValue="{Binding TransportName}"
                                                          SelectedValueBinding="{Binding Content}">
                                                    <ComboBoxItem Content="REST" />
                                                    <ComboBoxItem Content="Bluetooth" />
                                                </ComboBox>
                                                <TextBox Grid.Column="3"
                                                         PlaceholderText="Device ID / BLE address"
                                                         Text="{Binding DeviceId}" />
                                                <CheckBox Grid.Column="4"
                                                          VerticalAlignment="Center"
                                                          Content="Enabled"
                                                          Foreground="Gold"
                                                          IsChecked="{Binding Enabled}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary"
                                        Command="{Binding Settings.AddDeviceCommand}"
                                        Content="Add Device"
                                        Foreground="Gold" />
                                <Button Classes="primary"
                                        Command="{Binding Settings.SaveCommand}"
                                        Content="Save Settings" />
                            </StackPanel>
                            <TextBlock FontSize="12"
                                       Foreground="#8B949E"
                                       Text="For two identical H5110 sensors, enter their Bluetooth addresses after discovery so Inside and Lanai remain distinct."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem FontWeight="Bold" Header="Log">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="2">
                <TextBlock Grid.Row="0"
                           FontSize="24"
                           FontWeight="Bold"
                           Text="Logging Options" />
                <CheckBox Grid.Row="1"
                          Content="Log to file"
                          IsChecked="{Binding LogToFile}" />
                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Log:" />
                    <TextBox Grid.Column="1"
                             VerticalAlignment="Center"
                             Text="{Binding LogFilePath}" />
                    <Button Grid.Column="2"
                            Padding="10,7"
                            Command="{Binding ApplyLogFilePathCommand}"
                            Content="Apply" />
                </Grid>
                <Border Grid.Row="3"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox ItemsSource="{Binding Entries}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="4,2" />
                                <!--  Adjust padding as needed  -->
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <TextBlock FontFamily="Consolas"
                                           Text="{Binding DisplayText}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="4"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="5">
                    <TextBlock MaxWidth="430"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                    <TextBlock MaxWidth="430" FontWeight="Bold" 
                               VerticalAlignment="Center"
                               Text="{Binding Entries.Count, StringFormat=' Count: {0}'}"
                               TextWrapping="Wrap" />
                    <Button Padding="18,9"
                            Command="{Binding ClearLogCommand}"
                            Content="Clear Log" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
